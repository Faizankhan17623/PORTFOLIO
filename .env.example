# Frontend environment variables
# Copy this file to .env and fill in the values

# URL of the backend API (local dev)
VITE_API_URL=http://localhost:5000

# For production, set this to your deployed backend URL
# VITE_API_URL=https://your-backend.onrender.com

# Optional. Moves the private page to a path of your choice (for example /something-only-you-know).
# Leave it out to keep the default. Set it in Vercel as well, then redeploy.
# VITE_PRIVATE_PATH=
