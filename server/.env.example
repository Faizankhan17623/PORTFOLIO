MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio
PORT=5000
FRONTEND_URL=http://localhost:5173

# ── Spotify "Now Playing" (#9) ──────────────────────────
# Create an app at https://developer.spotify.com/dashboard
# 1. Get the Client ID + Client Secret from your app settings.
# 2. Authorize once with scope "user-read-currently-playing" to obtain a refresh token.
# Leave these blank to disable the widget (it will just show "offline").
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ── Contact notifications + admin page ──────────────────
# Gmail: turn on 2-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below.
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Render's free plan blocks SMTP, so on Render use Resend instead (https://resend.com, free):
# create an API key and put it in RESEND_API_KEY. Without a verified domain, Resend only delivers
# to the email your Resend account was created with, so use that address as NOTIFY_TO/EMAIL_USER.
RESEND_API_KEY=
# Optional sender, e.g. Portfolio <onboarding@resend.dev> (default)
RESEND_FROM=
# Optional: send notifications somewhere other than EMAIL_USER
NOTIFY_TO=
# Private dashboard: a long random password (12+ chars) and a separate token secret
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
